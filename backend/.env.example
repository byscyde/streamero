# ---- STREAMERO backend configuration (copy to .env; never commit real values) ----
NODE_ENV=development
PORT=8080
# Public base URL that clients use to reach the API (used to build signed media URLs)
PUBLIC_BASE_URL=http://localhost:8080
# Comma separated origins allowed to call the API from a browser (admin dashboard)
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgres://streamero:streamero@localhost:5432/streamero
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# Secrets: generate with `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
MEDIA_SIGNING_SECRET=change-me-media-secret-at-least-32-chars-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MEDIA_URL_TTL_SECONDS=21600

# Storage: "local" (filesystem, development) or "s3" (any S3-compatible service, e.g. MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=streamero-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Media processing
WORK_DIR=./data/work
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT_SECONDS=7200
FFMPEG_THREADS=2
MAX_UPLOAD_BYTES=21474836480
WORKER_CONCURRENCY=1
# Comma separated hostnames that the URL importer may download from (empty = disabled)
IMPORT_ALLOWED_HOSTS=
# Comma separated absolute directories the "server folder" importer may read from (empty = disabled)
IMPORT_ALLOWED_DIRS=
# Never enable in production: lets the URL importer reach private/loopback networks (SSRF guard off)
IMPORT_ALLOW_PRIVATE_NETWORKS=false

# Email (SMTP). When SMTP_URL is empty, emails are written to the structured log in development only.
SMTP_URL=
MAIL_FROM="STREAMERO <no-reply@streamero.local>"
APP_LINK_BASE=streamero://

# Sign in with Apple (optional): your app's bundle id / services id
APPLE_CLIENT_IDS=

# YouTube Data API v3 key (optional; enables YouTube discovery)
YOUTUBE_API_KEY=

# First administrator bootstrapped on `npm run seed` (only if no admin exists)
BOOTSTRAP_ADMIN_EMAIL=admin@streamero.local
BOOTSTRAP_ADMIN_PASSWORD=
LOG_LEVEL=info
