# Docker Compose settings for the whole stack (copy to .env). Generate secrets with: openssl rand -base64 48
PUBLIC_BASE_URL=http://localhost:8088
HTTP_PORT=8088
POSTGRES_PASSWORD=
S3_ACCESS_KEY=streamero
S3_SECRET_KEY=
JWT_ACCESS_SECRET=
MEDIA_SIGNING_SECRET=
BOOTSTRAP_ADMIN_EMAIL=admin@streamero.local
BOOTSTRAP_ADMIN_PASSWORD=
# Optional
SMTP_URL=
MAIL_FROM="STREAMERO <no-reply@scyde.dev>"
# Web player base URL used in email links (reset-password / verify-email open in the browser)
APP_LINK_BASE=https://app.streamero.net/
# Fill missing tags of newly ingested tracks from MusicBrainz (+ Cover Art Archive) when confidence >= 90 %
METADATA_AUTOFILL=false
IMPORT_ALLOWED_HOSTS=
IMPORT_ALLOWED_DIRS=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
YOUTUBE_API_KEY=
WORKER_CONCURRENCY=1
WORKER_CPUS=2
WORKER_MEMORY=2g
