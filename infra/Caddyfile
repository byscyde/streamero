# Automatic HTTPS (Let's Encrypt) in front of STREAMERO's nginx.
# STREAMERO_DOMAIN must point (DNS A/AAAA record) at this server, and ports 80 + 443 must be open.
{$STREAMERO_DOMAIN} {
	encode zstd gzip
	reverse_proxy nginx:80 {
		flush_interval -1
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
